# Gemini API (필수) — https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
# 조사 단계 모델 (기본 gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# 계획·종합·검증 단계 모델 (기본 gemini-2.5-pro)
GEMINI_MODEL_PRO=gemini-2.5-pro

# 이메일 발송 (Gmail: 2단계 인증 + 앱 비밀번호 https://myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
OWNER_EMAIL=
# 이메일 속 링크의 기준 URL (배포 주소)
PUBLIC_BASE_URL=

# 동시 조사 실행 수 (기본 2)
MAX_CONCURRENT_RUNS=2

# 공식 원천 데이터 (선택 — 있으면 리포트에 통계청/전자공시 원천 수치 사용)
# KOSIS: kosis.kr 회원가입 → 활용신청(OpenAPI) / DART: opendart.fss.or.kr 인증키 신청
KOSIS_API_KEY=
DART_API_KEY=

# 관리자 API 토큰 (필수) — 주문 실행/조회용 임의의 긴 문자열
ADMIN_TOKEN=

# 고객 결제 안내 표시용 (있는 것만 채우면 됨)
PAYPAL_ME=
TOSS_ID=

# 토스페이먼츠 결제위젯 (카드/간편결제 자동 승인) — developers.tosspayments.com 내 개발정보
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 에이전트 USDC 지갑 주소 (Circle 지갑 생성 후)
USDC_ADDRESS=
USDC_CHAIN=BASE-SEPOLIA

# Circle Developer-Controlled Wallets (2단계에서)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=

# 서버 포트
PORT=8080

# 앱 내 결제(IAP) 서버 검증
ANDROID_PACKAGE_NAME=com.lightonpluslab.deepdesk
# Google Play 서비스 계정 JSON 원문 또는 base64 중 하나를 설정
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_B64=
APPLE_BUNDLE_ID=com.lightonpluslab.deepdesk
# 선택: 소모성 상품은 필요하지 않음
APPLE_SHARED_SECRET=
